{"html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>System Design at Scale \u2014 Interview Prep</title>\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#F6F4EF;\n    --panel:#FFFFFF;\n    --panel-2:#FBF9F4;\n    --border:#E4E0D4;\n    --text:#211F1B;\n    --muted:#716B5E;\n    --accent:#2F7A72;\n    --accent-ink:#F3FBF9;\n    --accent-soft:#E3F1EE;\n    --gold:#B8792F;\n    --gold-soft:#F5E9D8;\n    --code-bg:#EFECE2;\n    --danger:#B5502F;\n    --shadow: 0 1px 2px rgba(30,26,18,0.05);\n    --mono: 'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;\n    --sans: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n  }\n  @media (prefers-color-scheme: dark){\n    :root:not([data-theme=\"light\"]){\n      --bg:#15181A;\n      --panel:#1B1F21;\n      --panel-2:#202426;\n      --border:#2C3133;\n      --text:#E9E6DE;\n      --muted:#9A968A;\n      --accent:#5FBFB2;\n      --accent-ink:#0B1716;\n      --accent-soft:#1E3230;\n      --gold:#D9A15C;\n      --gold-soft:#332918;\n      --code-bg:#20262A;\n      --danger:#D98866;\n      --shadow: 0 1px 2px rgba(0,0,0,0.4);\n    }\n  }\n  :root[data-theme=\"dark\"]{\n    --bg:#15181A;\n    --panel:#1B1F21;\n    --panel-2:#202426;\n    --border:#2C3133;\n    --text:#E9E6DE;\n    --muted:#9A968A;\n    --accent:#5FBFB2;\n    --accent-ink:#0B1716;\n    --accent-soft:#1E3230;\n    --gold:#D9A15C;\n    --gold-soft:#332918;\n    --code-bg:#20262A;\n    --danger:#D98866;\n    --shadow: 0 1px 2px rgba(0,0,0,0.4);\n  }\n\n  *{box-sizing:border-box;}\n  html,body{margin:0;padding:0;}\n  body{\n    background:var(--bg);\n    color:var(--text);\n    font-family:var(--sans);\n    line-height:1.55;\n    -webkit-font-smoothing:antialiased;\n  }\n  a{color:var(--accent);}\n\n  .app{\n    display:flex;\n    min-height:100vh;\n  }\n\n  /* ---------- Sidebar ---------- */\n  .sidebar{\n    width:260px;\n    flex:0 0 260px;\n    border-right:1px solid var(--border);\n    padding:28px 16px 24px;\n    position:sticky;\n    top:0;\n    height:100vh;\n    overflow-y:auto;\n  }\n  .brand{\n    font-family:var(--mono);\n    font-size:13px;\n    letter-spacing:0.02em;\n    color:var(--muted);\n    padding:0 8px 18px;\n    border-bottom:1px solid var(--border);\n    margin-bottom:14px;\n  }\n  .brand b{color:var(--text);font-weight:600;}\n  .nav-item{\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    gap:10px;\n    width:100%;\n    text-align:left;\n    padding:10px 10px;\n    border-radius:8px;\n    border:1px solid transparent;\n    background:transparent;\n    color:var(--text);\n    font-family:var(--sans);\n    font-size:14.5px;\n    cursor:pointer;\n    margin-bottom:2px;\n  }\n  .nav-item:hover{background:var(--panel-2);}\n  .nav-item.active{\n    background:var(--accent-soft);\n    border-color:var(--accent);\n    color:var(--text);\n    font-weight:600;\n  }\n  .nav-num{\n    font-family:var(--mono);\n    font-size:12px;\n    color:var(--muted);\n    width:18px;\n    flex:0 0 18px;\n  }\n  .nav-item.active .nav-num{color:var(--accent);}\n  .nav-label{flex:1;}\n  .nav-count{\n    font-family:var(--mono);\n    font-size:11px;\n    color:var(--muted);\n    background:var(--panel-2);\n    border:1px solid var(--border);\n    padding:1px 6px;\n    border-radius:999px;\n  }\n  .progress-box{\n    margin-top:20px;\n    padding:14px 12px;\n    border:1px solid var(--border);\n    border-radius:10px;\n    background:var(--panel-2);\n  }\n  .progress-box .label{\n    font-family:var(--mono);\n    font-size:11px;\n    color:var(--muted);\n    margin-bottom:8px;\n  }\n  .progress-track{\n    height:6px;\n    border-radius:999px;\n    background:var(--border);\n    overflow:hidden;\n  }\n  .progress-fill{\n    height:100%;\n    background:var(--accent);\n    width:0%;\n    transition:width .25s ease;\n  }\n  .progress-num{\n    margin-top:8px;\n    font-family:var(--mono);\n    font-size:12px;\n    color:var(--text);\n  }\n  .reset-btn{\n    margin-top:10px;\n    width:100%;\n    font-family:var(--sans);\n    font-size:12px;\n    color:var(--muted);\n    background:transparent;\n    border:1px solid var(--border);\n    border-radius:7px;\n    padding:6px 8px;\n    cursor:pointer;\n  }\n  .reset-btn:hover{color:var(--danger);border-color:var(--danger);}\n\n  /* ---------- Main ---------- */\n  .main{\n    flex:1;\n    min-width:0;\n    padding:36px 40px 80px;\n    max-width:1200px;\n  }\n  .hero{\n    margin-bottom:34px;\n  }\n  .hero .eyebrow-free{\n    font-family:var(--mono);\n    font-size:13px;\n    color:var(--accent);\n    margin:0 0 10px;\n  }\n  .hero h1{\n    font-family:var(--mono);\n    font-size:30px;\n    line-height:1.25;\n    margin:0 0 12px;\n    font-weight:600;\n    letter-spacing:-0.01em;\n  }\n  .hero p{\n    color:var(--muted);\n    max-width:62ch;\n    margin:0 0 6px;\n    font-size:15px;\n  }\n  .hero .source-note{\n    font-size:13px;\n    color:var(--muted);\n    border-left:2px solid var(--border);\n    padding-left:12px;\n    margin-top:16px;\n  }\n\n  .section-head{\n    display:flex;\n    align-items:baseline;\n    gap:10px;\n    margin:44px 0 16px;\n    padding-bottom:10px;\n    border-bottom:1px solid var(--border);\n  }\n  .section-head .num{\n    font-family:var(--mono);\n    color:var(--accent);\n    font-size:14px;\n  }\n  .section-head h2{\n    font-family:var(--mono);\n    font-size:19px;\n    margin:0;\n    font-weight:600;\n  }\n  .section-head .count{\n    margin-left:auto;\n    font-family:var(--mono);\n    font-size:12px;\n    color:var(--muted);\n  }\n\n  .qcard{\n    border:1px solid var(--border);\n    border-radius:10px;\n    background:var(--panel);\n    margin-bottom:12px;\n    overflow:hidden;\n  }\n  .qhead{\n    display:flex;\n    align-items:flex-start;\n    gap:12px;\n    padding:14px 16px;\n    cursor:pointer;\n    user-select:none;\n  }\n  .qcheck{\n    margin-top:3px;\n    flex:0 0 auto;\n    width:18px;height:18px;\n    border-radius:5px;\n    border:1.5px solid var(--border);\n    display:flex;align-items:center;justify-content:center;\n    cursor:pointer;\n    background:var(--panel);\n  }\n  .qcheck.done{\n    background:var(--accent);\n    border-color:var(--accent);\n  }\n  .qcheck.done::after{\n    content:\"\u2713\";\n    color:var(--accent-ink);\n    font-size:12px;\n    font-weight:700;\n  }\n  .qtext{\n    flex:1;\n    font-size:15px;\n    font-weight:500;\n  }\n  .qtext.done-text{color:var(--muted);text-decoration:line-through;text-decoration-color:var(--border);}\n  .qchevron{\n    flex:0 0 auto;\n    color:var(--muted);\n    font-family:var(--mono);\n    font-size:13px;\n    transform:rotate(0deg);\n    transition:transform .15s ease;\n    margin-top:2px;\n  }\n  .qcard.open .qchevron{transform:rotate(90deg);}\n  .qbody{\n    display:none;\n    padding:2px 16px 20px 46px;\n    border-top:1px solid var(--border);\n    font-size:14.5px;\n  }\n  .qcard.open .qbody{display:block; padding-top:14px;}\n  .qbody p{margin:0 0 12px;}\n  .qbody ul{margin:0 0 12px; padding-left:20px;}\n  .qbody li{margin-bottom:6px;}\n  .qbody strong{color:var(--text);}\n  code{\n    font-family:var(--mono);\n    background:var(--code-bg);\n    padding:1px 5px;\n    border-radius:4px;\n    font-size:0.92em;\n  }\n  pre{\n    font-family:var(--mono);\n    background:var(--code-bg);\n    padding:12px 14px;\n    border-radius:8px;\n    overflow-x:auto;\n    font-size:13px;\n    margin:0 0 14px;\n    border:1px solid var(--border);\n  }\n  .diagram{\n    background:var(--panel-2);\n    border:1px solid var(--border);\n    border-radius:8px;\n    padding:14px;\n    margin:0 0 14px;\n    overflow-x:auto;\n  }\n  .diagram svg{display:block; margin:0 auto; max-width:100%; height:auto;}\n  .tag{\n    display:inline-block;\n    font-family:var(--mono);\n    font-size:10.5px;\n    color:var(--gold);\n    background:var(--gold-soft);\n    border:1px solid var(--gold);\n    border-radius:5px;\n    padding:1px 6px;\n    margin-bottom:10px;\n  }\n  table.cmp{\n    width:100%;\n    border-collapse:collapse;\n    margin:0 0 14px;\n    font-size:13.5px;\n  }\n  table.cmp th, table.cmp td{\n    border:1px solid var(--border);\n    padding:7px 10px;\n    text-align:left;\n    vertical-align:top;\n  }\n  table.cmp th{\n    background:var(--panel-2);\n    font-family:var(--mono);\n    font-size:12px;\n    font-weight:600;\n  }\n\n  ::selection{background:var(--accent-soft);}\n\n  @media (max-width: 820px){\n    .sidebar{\n      width:100%;\n      flex:none;\n      height:auto;\n      position:relative;\n      border-right:none;\n      border-bottom:1px solid var(--border);\n    }\n    .app{flex-direction:column;}\n    .main{padding:24px 18px 60px; max-width:100%;}\n  }\n</style>\n</head>\n<body>\n<div class=\"app\">\n  <nav class=\"sidebar\" id=\"sidebar\">\n    <div class=\"brand\"><b>System Design</b><br>At scale \u2014 interview prep</div>\n    <div id=\"navList\"></div>\n    <div class=\"progress-box\">\n      <div class=\"label\">REVIEWED</div>\n      <div class=\"progress-track\"><div class=\"progress-fill\" id=\"progressFill\"></div></div>\n      <div class=\"progress-num\" id=\"progressNum\">0 / 0</div>\n      <button class=\"reset-btn\" id=\"resetBtn\">Reset progress</button>\n    </div>\n  </nav>\n\n  <main class=\"main\">\n    <div class=\"hero\">\n      <p class=\"eyebrow-free\">Prep guide</p>\n      <h1>Design a full-stack app for millions of users</h1>\n      <p>A senior-architect-ready answer, end to end \u2014 requirements, a back-of-envelope capacity estimate, web framework choice, auth, edge/CDN/gateway, service architecture, data layer, caching, async messaging, deployment, reliability, security, and how to pace all of it in a 30\u201345 minute interview.</p>\n      <div class=\"source-note\">12 sections \u00b7 click a question to expand it \u00b7 check items off as you review them (saved in this browser only)</div>\n    </div>\n    <div id=\"content\"></div>\n  </main>\n</div>\n\n\n<script>\nconst DATA = [\n{\n  id:\"framing\", title:\"Framing the Problem\",\n  questions:[\n    {\n      q:\"How do you open when asked to \\\"design a full-stack app that serves millions of users\\\"?\",\n      a:`<p>Treat the prompt as deliberately underspecified and spend the first few minutes narrowing it, out loud, before any design work starts. Two categories of questions matter: functional (what does the app actually do \u2014 pick one or two core workflows to design deeply rather than trying to cover everything shallowly) and non-functional (how many users, what \"millions\" means concretely, read-heavy or write-heavy, global or single-region, latency and availability targets, what data is sensitive enough to need special handling). Anchoring on a concrete example \u2014 \"let's say this is a member portal, the core flows are browsing content, checking account status, and one write-heavy action like submitting a claim\" \u2014 gives every later decision something real to be justified against instead of floating in the abstract.</p>\n      <ul>\n        <li><strong>Functional scope:</strong> pick 2\u20133 core user workflows and say so explicitly \u2014 designing everything shallowly is worse than designing the important 20% deeply.</li>\n        <li><strong>Non-functional targets:</strong> concrete numbers for scale (10M registered / 1M daily active is a reasonable anchor), availability (99.9% vs 99.99% changes the entire reliability story), and latency (sub-200ms API responses vs \"reasonably fast\").</li>\n        <li><strong>Read vs. write ratio:</strong> most consumer apps are 90%+ reads \u2014 this single fact justifies caching and read replicas before anything else does.</li>\n        <li><strong>Time budget:</strong> roughly 5 minutes on requirements, 10\u201315 on high-level architecture, 15\u201320 going deep on 2\u20133 components the interviewer steers you toward, 5 on trade-offs and what you'd cut for an MVP.</li>\n      </ul>`\n    },\n    {\n      q:\"How would you size the system with a back-of-envelope estimate?\",\n      a:`<p>A rough capacity estimate is what turns \"millions of users\" from a scary phrase into a specific number of servers, a specific database size, and a specific caching strategy \u2014 and it's a strong signal on its own, independent of the final numbers being exactly right. The goal is order-of-magnitude accuracy in under two minutes, not precision.</p>\n      <pre><code>// Assume: 10M registered users, 10% daily active (DAU) = 1M DAU\n// Each active user makes ~20 requests/day (page views + API calls)\n\nAverage requests/sec = (1,000,000 users &times; 20 requests) / 86,400 sec\n                      &asymp; 231 req/sec\n\n// Traffic is never flat \u2014 plan for peak, not average.\n// A typical peak-to-average ratio for a consumer app is 3-5x.\nPeak req/sec &asymp; 231 &times; 5 &asymp; 1,150 req/sec\n\n// Storage: assume each user generates 50KB of data over their lifetime\n// (profile, activity history, documents)\nTotal storage &asymp; 10,000,000 &times; 50KB &asymp; 500GB\n\n// growing at, say, 500K new users/month &times; 50KB &asymp; 25GB/month\n// \u2014 comfortably within a single well-provisioned PostgreSQL instance\n// for years, which is the point: this justifies NOT sharding on day one.</code></pre>\n      <p><strong>Good interview signal:</strong> the exact multiplier matters less than showing you know average traffic and peak traffic are different numbers, and that peak is what you provision for. A storage estimate this small is itself a finding: it tells you a single primary database with read replicas is enough for a long time, and sharding would be solving a problem you don't have yet.</p>`\n    }\n  ]\n},\n{\n  id:\"client\", title:\"Client Layer & Web Framework\",\n  questions:[\n    {\n      q:\"Which web framework would you choose, and why?\",\n      a:`<p>Next.js is the default-strong answer for a consumer-facing full-stack app today, and the reason to give isn't \"it's popular\" \u2014 it's that it lets each page pick its own rendering strategy instead of forcing the whole app into one model. A marketing/landing page can be statically generated at build time; a product page that changes daily can use ISR (incremental static regeneration) to stay fast while staying fresh; a logged-in dashboard that must be current on every load uses SSR; and a page with one slow, non-critical section can stream that section in via Suspense while the rest of the page is already interactive.</p>\n      <ul>\n        <li><strong>Next.js (App Router)</strong> \u2014 the right default: mixed rendering strategies per route, React Server Components to ship less client JS, built-in image/font optimization, and a mature deployment story on Vercel or self-hosted via Node.</li>\n        <li><strong>Remix</strong> \u2014 a strong alternative if the app is heavily form/mutation-driven; its loader/action model maps very directly onto server-driven data flows, at the cost of a smaller ecosystem than Next.js.</li>\n        <li><strong>A plain SPA (Vite + React Router)</strong> \u2014 reasonable for an internal tool or admin dashboard where SEO doesn't matter and everything is behind auth anyway; wrong choice for a public-facing product where first-load performance and SEO both matter.</li>\n        <li><strong>Mobile clients</strong> \u2014 React Native (code/logic sharing with the web team) for most product teams, or fully native when a feature needs the top tier of platform integration or performance.</li>\n      </ul>`\n    },\n    {\n      q:\"REST, GraphQL, or tRPC for the API contract?\",\n      a:`<p>This is a \"depends on the org, not the technology\" answer, and saying so is the strong signal \u2014 naming one winner unconditionally is the weaker answer. REST is the safe, boring default: cacheable by URL, understood by every tool and every engineer, trivial to version. GraphQL earns its complexity when the client genuinely needs to shape its own queries \u2014 a mobile app and a web app with very different data needs hitting the same backend, or a product with deeply nested, client-driven views where REST would mean either over-fetching or a combinatorial explosion of endpoints. tRPC is the pragmatic middle ground specifically when both ends are TypeScript in the same monorepo \u2014 end-to-end type safety with none of GraphQL's schema/resolver ceremony, at the cost of tight coupling to that one stack.</p>\n      <p><strong>Common follow-up \u2014 when do you actually reach for GraphQL?</strong> Start with REST, reach for GraphQL only once \"the frontend needs a slightly different shape of this data on three different screens\" has actually happened more than once. Whatever is chosen, the API Gateway layer is what actually terminates it before it reaches internal services \u2014 the contract choice doesn't change that boundary.</p>`\n    }\n  ]\n},\n{\n  id:\"auth\", title:\"Auth & Identity\",\n  questions:[\n    {\n      q:\"Session cookies or JWTs \u2014 and where does auth actually get checked?\",\n      a:`<p>Session cookies (an opaque ID, server-side session store, typically Redis) and JWTs (a signed, self-contained token) trade off in exactly one place: JWTs avoid a server-side lookup on every request by putting the claims in the token itself, at the cost of being hard to revoke before they expire \u2014 a compromised JWT is valid until it naturally expires unless you build a denylist, which reintroduces the server-side check you were trying to avoid. For a system with millions of users, a hybrid is the pragmatic default: a short-lived JWT access token (5\u201315 minutes) for stateless verification at the edge, paired with a longer-lived, revocable refresh token stored server-side that mints new access tokens \u2014 most of the read traffic never touches the session store, but a compromised session can still be killed within minutes, not left valid for the JWT's full lifetime.</p>\n      <ul>\n        <li><strong>Where it terminates:</strong> validate the access token at the API Gateway so a request with a bad or expired token never reaches an internal service \u2014 internal services trust a verified identity header the gateway attaches, they don't re-verify the token themselves.</li>\n        <li><strong>Third-party/enterprise login:</strong> OAuth2 for delegated access (login with Google, connect a calendar), OIDC (a thin identity layer on OAuth2) for actual authentication, SAML if an enterprise customer's IdP requires it \u2014 Okta/Auth0/Cognito are the usual off-the-shelf choices rather than hand-rolling this.</li>\n        <li><strong>Multi-tenant SaaS:</strong> tenant ID belongs in the token's claims, checked at the gateway, so a leaked or forged request can't cross tenant boundaries even if a downstream service has a bug.</li>\n      </ul>`\n    }\n  ]\n},\n{\n  id:\"edge\", title:\"Edge, CDN & API Gateway\",\n  questions:[\n    {\n      q:\"What sits between the client and your services?\",\n      a:`<p>Two distinct layers, often conflated in an interview answer but worth naming separately: a CDN handles static, cacheable content close to the user (JS/CSS bundles, images, fonts, and \u2014 with the right cache-control headers \u2014 public HTML and API responses); an API Gateway handles everything that actually needs to reach your backend, and is where cross-cutting concerns get enforced exactly once instead of duplicated in every service.</p>\n      <ul>\n        <li><strong>CDN responsibilities:</strong> versioned static assets with long <code>max-age</code> + <code>immutable</code>; selectively cached public API/HTML responses with short TTLs and <code>stale-while-revalidate</code>; edge rendering for pages that are mostly the same across users.</li>\n        <li><strong>API Gateway responsibilities:</strong> TLS termination, authentication (validating the access token from the section above), rate limiting per user/IP/API key, request routing to the right backend service, and request/response logging with a correlation ID attached to every request for tracing.</li>\n      </ul>\n      <pre><code>// Illustrative gateway route config (Kong-style) \u2014 the shape matters\n// more than the specific product: authn + rate limit + route, in that order\nroutes:\n  - path: /api/v1/claims\n    service: claims-service\n    plugins:\n      - jwt-auth          # reject before it reaches the service\n      - rate-limiting:\n          minute: 60\n          policy: sliding-window\n      - correlation-id      # attach a request ID for tracing downstream</code></pre>`\n    }\n  ]\n},\n{\n  id:\"services\", title:\"Service Architecture\",\n  questions:[\n    {\n      q:\"Monolith or microservices \u2014 and how do you decide when to split?\",\n      a:`<p>Start with a modular monolith \u2014 a single deployable with clear internal module boundaries (auth, billing, notifications as separate packages/directories with disciplined interfaces between them) \u2014 and split a module out into its own service only once a specific, concrete reason forces it: the module needs an independently faster deploy cadence than the rest of the app, a genuinely different scaling profile (a notification worker that needs 50 instances while the core API needs 5), or a different team needs to own its release cycle without coordinating with everyone else. Splitting by default, before any of those pressures exist, buys network calls, distributed tracing, and data-consistency complexity in exchange for nothing.</p>\n      <p>The modular-monolith's internal boundaries are what make a later split cheap \u2014 if auth already only talks to the rest of the app through a clean interface, extracting it is a deployment change, not a rewrite. A monorepo (Nx, Turborepo) is a separate axis entirely from this decision \u2014 repo structure, backend runtime, and frontend runtime (microfrontends) are three independent choices that get conflated in conversation.</p>`\n    },\n    {\n      q:\"What is a BFF (Backend-for-Frontend), and when do you add one?\",\n      a:`<p>A BFF is a thin service that sits between a specific client (web, iOS, a partner API) and the backend services, shaped around exactly what that client needs \u2014 aggregating three internal service calls into one response, or reshaping a payload so the mobile app doesn't have to do that work on a slow connection. It earns its place once different clients start needing meaningfully different shapes of the same data; before that point, every client hitting the same general-purpose API is simpler and one less thing to deploy and own.</p>`\n    }\n  ]\n},\n{\n  id:\"data\", title:\"Data Layer\",\n  questions:[\n    {\n      q:\"SQL or NoSQL \u2014 how do you actually decide?\",\n      a:`<p>The honest answer is \"most core application data is relational, and PostgreSQL is a strong default even at large scale\" \u2014 reach for NoSQL when a specific access pattern genuinely doesn't fit rows and joins, not because \"NoSQL scales better\" (a myth; a well-indexed, properly-replicated PostgreSQL instance handles far more scale than most systems ever reach).</p>\n      <table class=\"cmp\">\n        <tr><th></th><th>Reach for it when</th></tr>\n        <tr><td><strong>PostgreSQL (relational)</strong></td><td>Data has real relationships, you need transactions/ACID guarantees, or the access patterns aren't fully known yet \u2014 the default for core application data.</td></tr>\n        <tr><td><strong>DynamoDB / key-value</strong></td><td>Access is almost always \"get by known key,\" at massive scale, with predictable low-latency reads \u2014 a session store, a shopping cart, a feature-flag lookup.</td></tr>\n        <tr><td><strong>Elasticsearch</strong></td><td>Full-text search, faceted filtering, relevance ranking \u2014 never the source of truth, always synced from the real database.</td></tr>\n        <tr><td><strong>A vector store (pgvector, etc.)</strong></td><td>The product has an AI/RAG feature needing similarity search over embeddings.</td></tr>\n      </table>`\n    },\n    {\n      q:\"How do you scale the database as write and read volume grow?\",\n      a:`<p>In order of how early you reach for them: indexing correctly first (the single highest-leverage, lowest-cost fix), then read replicas (routes the 90%+ read traffic most apps have away from the primary, which stays dedicated to writes), then connection pooling (PgBouncer) so thousands of app-server connections don't exhaust the database's own connection limit, and only once all of that is saturated, sharding (splitting data across multiple database instances by a key like <code>user_id</code> hash) \u2014 a much bigger operational commitment that a system sized like the estimate above rarely justifies from day one.</p>\n      <p><strong>Common follow-up \u2014 what do you give up once you shard?</strong> Cross-shard queries and transactions become genuinely hard \u2014 naming that trade-off explicitly is a stronger signal than presenting sharding as a free scaling lever, and it's exactly why it's named last on this list rather than jumped to first.</p>`\n    }\n  ]\n},\n{\n  id:\"caching\", title:\"Caching Strategy\",\n  questions:[\n    {\n      q:\"What does caching look like across the whole stack, end to end?\",\n      a:`<div class=\"diagram\">\n      <svg viewBox=\"0 0 800 200\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%;max-width:800px\">\n        <rect x=\"10\" y=\"10\" width=\"780\" height=\"180\" rx=\"16\" fill=\"#ec4899\" opacity=\"0.04\"/>\n        <rect x=\"30\" y=\"60\" width=\"132\" height=\"60\" rx=\"10\" fill=\"#ec4899\" opacity=\"0.12\" stroke=\"#ec4899\" stroke-width=\"1.5\"/>\n        <text x=\"96\" y=\"95\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"12\" font-weight=\"bold\">Browser cache</text>\n        <rect x=\"182\" y=\"60\" width=\"132\" height=\"60\" rx=\"10\" fill=\"#ec4899\" opacity=\"0.12\" stroke=\"#ec4899\" stroke-width=\"1.5\"/>\n        <text x=\"248\" y=\"95\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"12\" font-weight=\"bold\">CDN edge</text>\n        <rect x=\"334\" y=\"60\" width=\"132\" height=\"60\" rx=\"10\" fill=\"#ec4899\" opacity=\"0.12\" stroke=\"#ec4899\" stroke-width=\"1.5\"/>\n        <text x=\"400\" y=\"95\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"12\" font-weight=\"bold\">API Gateway</text>\n        <rect x=\"486\" y=\"60\" width=\"132\" height=\"60\" rx=\"10\" fill=\"#ec4899\" opacity=\"0.12\" stroke=\"#ec4899\" stroke-width=\"1.5\"/>\n        <text x=\"552\" y=\"95\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"12\" font-weight=\"bold\">Redis (app)</text>\n        <rect x=\"638\" y=\"60\" width=\"132\" height=\"60\" rx=\"10\" fill=\"#ec4899\" opacity=\"0.12\" stroke=\"#ec4899\" stroke-width=\"1.5\"/>\n        <text x=\"704\" y=\"95\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"12\" font-weight=\"bold\">DB query cache</text>\n        <line x1=\"162\" y1=\"90\" x2=\"182\" y2=\"90\" stroke=\"#f472b6\" stroke-width=\"2\" marker-end=\"url(#arrowP1)\"/>\n        <line x1=\"314\" y1=\"90\" x2=\"334\" y2=\"90\" stroke=\"#f472b6\" stroke-width=\"2\" marker-end=\"url(#arrowP1)\"/>\n        <line x1=\"466\" y1=\"90\" x2=\"486\" y2=\"90\" stroke=\"#f472b6\" stroke-width=\"2\" marker-end=\"url(#arrowP1)\"/>\n        <line x1=\"618\" y1=\"90\" x2=\"638\" y2=\"90\" stroke=\"#f472b6\" stroke-width=\"2\" marker-end=\"url(#arrowP1)\"/>\n        <text x=\"400\" y=\"35\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"12\" opacity=\"0.7\">A request only reaches the DB if every layer to its left misses</text>\n        <text x=\"400\" y=\"155\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"11\" opacity=\"0.6\">Each hop that hits saves a network round-trip and a unit of backend load</text>\n        <defs><marker id=\"arrowP1\" markerWidth=\"8\" markerHeight=\"6\" refX=\"8\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L8,3 L0,6\" fill=\"#f472b6\"/></marker></defs>\n      </svg>\n      </div>\n      <p>The strongest way to answer this is the waterfall above: a request only reaches the database once it has missed at every faster layer in front of it, and each layer exists because it's progressively cheaper and closer to the user than the one behind it. Browser cache and the CDN handle anything static or public; the API Gateway can cache whole responses for cacheable, non-personalized endpoints; Redis sits in front of the database for computed aggregates, session data, and anything read far more often than it changes; and the database's own query cache/shared buffers are the last line before disk I/O.</p>\n      <ul>\n        <li><strong>Invalidation is the actually hard part</strong> \u2014 a short TTL is the simple, safe default (bounded staleness, no explicit invalidation logic); explicit invalidation-on-write is fresher but means finding every code path that changes the underlying data.</li>\n        <li><strong>Cache stampede</strong> \u2014 when a hot key expires, many concurrent requests can miss simultaneously and hammer the database at once; fix with a lock so only one request repopulates the cache, or <code>stale-while-revalidate</code> so everyone gets the stale value while one background request refreshes it.</li>\n      </ul>`\n    }\n  ]\n},\n{\n  id:\"async\", title:\"Async & Messaging\",\n  questions:[\n    {\n      q:\"What moves off the request/response path, and how?\",\n      a:`<p>Anything that doesn't need to complete before the user gets a response \u2014 sending a notification, generating a document, updating a search index, calling a slow third-party API \u2014 goes through a queue instead of holding an HTTP request open. The producer publishes an event and returns immediately; one or more consumers process it independently, on their own schedule, and a failure in one consumer never blocks the request that triggered it or any other consumer.</p>\n      <ul>\n        <li><strong>Queue vs. pub/sub:</strong> a queue (SQS) is point-to-point \u2014 one worker per message, good for distributing units of work across a pool; pub/sub (SNS, or a topic generally) is one-to-many \u2014 good for \"several unrelated systems all need to react to this event.\" They combine constantly: publish once to a topic, fan out to several queues, one per consumer.</li>\n        <li><strong>Failure handling:</strong> a dead-letter queue catches messages that exceed their retry limit, so they stop blocking the main queue instead of being silently dropped.</li>\n      </ul>`\n    },\n    {\n      q:\"How do you keep data consistent across services without a distributed transaction?\",\n      a:`<p>The Saga pattern: a sequence of local transactions, one per service, where every step has a matching compensating transaction that undoes its work if a later step fails. Placing an order might be create-order &rarr; charge-payment &rarr; reserve-inventory &rarr; schedule-shipping; if inventory reservation fails, you don't roll back a database transaction spanning services (there isn't one) \u2014 you run compensations forward, refunding the payment and cancelling the order.</p>\n      <p><strong>Common follow-up \u2014 how does the first step publish its event reliably?</strong> The Transactional Outbox pattern \u2014 write the event to an outbox table in the same local transaction as the business write, and a separate relay process publishes it \u2014 solves the dual-write problem where a crash between the DB commit and the publish would otherwise lose the event silently.</p>`\n    }\n  ]\n},\n{\n  id:\"deploy\", title:\"Deployment & Infrastructure\",\n  questions:[\n    {\n      q:\"What does the path from a merged PR to production look like?\",\n      a:`<p>Code is packaged into a container image, pushed to a registry, and deployed by an orchestrator (ECS or Kubernetes) that handles scheduling, health checks, and restarts \u2014 with the infrastructure itself defined as code (Terraform or CloudFormation) so an environment can be reproduced or torn down deterministically rather than hand-configured. The pipeline promotes a build through environments in order \u2014 dev &rarr; staging &rarr; production \u2014 gated by automated tests at minimum, and often a manual approval before the final production step.</p>\n      <ul>\n        <li><strong>Rollout strategy:</strong> canary (a small % of traffic first, ramp up while watching error rate and latency against a control group) for anything with real user-facing risk; blue-green when instant rollback matters more than gradual exposure; rolling updates as the default for routine, lower-risk deploys.</li>\n        <li><strong>Why this matters at \"millions of users\" scale specifically:</strong> a bad deploy at this scale isn't a minor incident \u2014 canary/staged rollout is what turns \"one engineer's mistake\" into \"a blip affecting 1% of traffic for two minutes\" instead of an outage.</li>\n      </ul>`\n    }\n  ]\n},\n{\n  id:\"reliability\", title:\"Reliability & Observability\",\n  questions:[\n    {\n      q:\"How do you design for things going wrong, not just for the happy path?\",\n      a:`<p>Every outbound call between services gets the same layered defense: a timeout so nothing waits forever, retries with backoff and jitter for transient failures, a circuit breaker that stops calling a dependency entirely once it's clearly down, and a bulkhead that caps how much of your own capacity any single dependency can consume. For availability specifically: Multi-AZ (redundant infrastructure across physically separate datacenters in the same region, with automatic failover) covers the failure mode that actually happens most often; multi-region is reserved for when a full-region outage is genuinely unacceptable for the business, given the real cost and consistency trade-offs it adds.</p>\n      <ul>\n        <li><strong>SLOs and error budgets</strong> turn \"how reliable should this be\" from a vague aspiration into a number the whole team is accountable to, and a concrete trigger for when to prioritize reliability work over new features.</li>\n        <li><strong>Golden signals</strong> (latency, traffic, errors, saturation) are what every service's dashboard should be built around \u2014 generic infrastructure metrics (CPU, memory) are useful for debugging but rarely tell you a user is actually affected.</li>\n      </ul>`\n    },\n    {\n      q:\"How do you know something is wrong before a user reports it?\",\n      a:`<p>Three complementary signals, not one: logs for deep-diving a specific incident after the fact, metrics for cheap, always-on alerting on trends, and distributed traces for following one slow or failed request across every service it touched. A trace context (trace ID + parent span ID) generated at the very first entry point and propagated on every outbound call \u2014 as an HTTP header, or in a message's metadata for async paths \u2014 is what lets the full picture reassemble later even though no single service ever saw the whole request, tied together with logs via a shared correlation ID.</p>`\n    }\n  ]\n},\n{\n  id:\"security\", title:\"Security\",\n  questions:[\n    {\n      q:\"What does defense-in-depth look like for a system at this scale?\",\n      a:`<p>No single control is trusted to be the only thing standing between an attacker and the data \u2014 each layer assumes the ones around it could fail. Encryption in transit (TLS everywhere, including internal service-to-service traffic via a service mesh's mTLS) and at rest (database and object storage encryption, keys managed by a dedicated service like KMS, never embedded in application config); secrets in a dedicated manager, never in environment variables checked into source or baked into an image; least-privilege IAM so a compromised service can only reach what it specifically needs, not the whole account; a WAF at the edge filtering common attack patterns before they reach the application; and rate limiting doing double duty as both a reliability control and an abuse/credential-stuffing defense.</p>\n      <ul>\n        <li>Input validation and output encoding at every trust boundary \u2014 never trust that a request reaching an internal service has already been validated by whatever called it.</li>\n        <li>For a system handling sensitive data specifically (health, financial, PII): audit logging on every access to that data, not just on writes \u2014 \"who looked at this record and when\" is often a compliance requirement, not an optional nice-to-have.</li>\n      </ul>`\n    }\n  ]\n},\n{\n  id:\"together\", title:\"Putting It All Together\",\n  questions:[\n    {\n      q:\"How does everything above fit together into one diagram?\",\n      a:`<div class=\"diagram\">\n      <svg viewBox=\"0 0 820 380\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%;max-width:820px\">\n        <rect x=\"10\" y=\"10\" width=\"800\" height=\"360\" rx=\"16\" fill=\"#8b5cf6\" opacity=\"0.04\"/>\n        <rect x=\"30\" y=\"30\" width=\"140\" height=\"44\" rx=\"8\" fill=\"#8b5cf6\" opacity=\"0.15\" stroke=\"#8b5cf6\" stroke-width=\"1.5\"/>\n        <text x=\"100\" y=\"57\" text-anchor=\"middle\" fill=\"#8b5cf6\" font-size=\"12\" font-weight=\"bold\">Web / Mobile</text>\n        <rect x=\"30\" y=\"100\" width=\"140\" height=\"40\" rx=\"8\" fill=\"#06b6d4\" opacity=\"0.15\" stroke=\"#06b6d4\" stroke-width=\"1.5\"/>\n        <text x=\"100\" y=\"125\" text-anchor=\"middle\" fill=\"#06b6d4\" font-size=\"11\" font-weight=\"bold\">CDN / Edge</text>\n        <rect x=\"30\" y=\"165\" width=\"140\" height=\"40\" rx=\"8\" fill=\"#06b6d4\" opacity=\"0.15\" stroke=\"#06b6d4\" stroke-width=\"1.5\"/>\n        <text x=\"100\" y=\"190\" text-anchor=\"middle\" fill=\"#06b6d4\" font-size=\"11\" font-weight=\"bold\">API Gateway</text>\n        <rect x=\"230\" y=\"120\" width=\"130\" height=\"40\" rx=\"8\" fill=\"#10b981\" opacity=\"0.15\" stroke=\"#10b981\" stroke-width=\"1.5\"/>\n        <text x=\"295\" y=\"145\" text-anchor=\"middle\" fill=\"#10b981\" font-size=\"11\" font-weight=\"bold\">Service A</text>\n        <rect x=\"230\" y=\"175\" width=\"130\" height=\"40\" rx=\"8\" fill=\"#10b981\" opacity=\"0.15\" stroke=\"#10b981\" stroke-width=\"1.5\"/>\n        <text x=\"295\" y=\"200\" text-anchor=\"middle\" fill=\"#10b981\" font-size=\"11\" font-weight=\"bold\">Service B</text>\n        <rect x=\"230\" y=\"230\" width=\"130\" height=\"40\" rx=\"8\" fill=\"#10b981\" opacity=\"0.15\" stroke=\"#10b981\" stroke-width=\"1.5\"/>\n        <text x=\"295\" y=\"255\" text-anchor=\"middle\" fill=\"#10b981\" font-size=\"11\" font-weight=\"bold\">Service C</text>\n        <rect x=\"420\" y=\"90\" width=\"130\" height=\"40\" rx=\"8\" fill=\"#ec4899\" opacity=\"0.15\" stroke=\"#ec4899\" stroke-width=\"1.5\"/>\n        <text x=\"485\" y=\"115\" text-anchor=\"middle\" fill=\"#ec4899\" font-size=\"11\" font-weight=\"bold\">Redis cache</text>\n        <rect x=\"420\" y=\"150\" width=\"130\" height=\"40\" rx=\"8\" fill=\"#f97316\" opacity=\"0.15\" stroke=\"#f97316\" stroke-width=\"1.5\"/>\n        <text x=\"485\" y=\"175\" text-anchor=\"middle\" fill=\"#f97316\" font-size=\"11\" font-weight=\"bold\">Postgres primary</text>\n        <rect x=\"420\" y=\"205\" width=\"130\" height=\"40\" rx=\"8\" fill=\"#f97316\" opacity=\"0.15\" stroke=\"#f97316\" stroke-width=\"1.5\"/>\n        <text x=\"485\" y=\"230\" text-anchor=\"middle\" fill=\"#f97316\" font-size=\"11\" font-weight=\"bold\">Read replicas</text>\n        <rect x=\"420\" y=\"260\" width=\"130\" height=\"40\" rx=\"8\" fill=\"#64748b\" opacity=\"0.15\" stroke=\"#64748b\" stroke-width=\"1.5\"/>\n        <text x=\"485\" y=\"285\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"11\" font-weight=\"bold\">Queue (SQS)</text>\n        <rect x=\"610\" y=\"260\" width=\"150\" height=\"40\" rx=\"8\" fill=\"#64748b\" opacity=\"0.15\" stroke=\"#64748b\" stroke-width=\"1.5\"/>\n        <text x=\"685\" y=\"285\" text-anchor=\"middle\" fill=\"#64748b\" font-size=\"11\" font-weight=\"bold\">Async workers</text>\n        <rect x=\"600\" y=\"30\" width=\"170\" height=\"90\" rx=\"8\" fill=\"#f59e0b\" opacity=\"0.1\" stroke=\"#f59e0b\" stroke-width=\"1.5\" stroke-dasharray=\"4\"/>\n        <text x=\"685\" y=\"50\" text-anchor=\"middle\" fill=\"#f59e0b\" font-size=\"11\" font-weight=\"bold\">Observability</text>\n        <text x=\"685\" y=\"70\" text-anchor=\"middle\" fill=\"#f59e0b\" font-size=\"10\">logs &middot; metrics</text>\n        <text x=\"685\" y=\"86\" text-anchor=\"middle\" fill=\"#f59e0b\" font-size=\"10\">traces &middot; alerts</text>\n        <text x=\"685\" y=\"105\" text-anchor=\"middle\" fill=\"#f59e0b\" font-size=\"10\">(every layer reports here)</text>\n        <line x1=\"100\" y1=\"74\" x2=\"100\" y2=\"100\" stroke=\"#a78bfa\" stroke-width=\"2\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"100\" y1=\"140\" x2=\"100\" y2=\"165\" stroke=\"#a78bfa\" stroke-width=\"2\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"170\" y1=\"185\" x2=\"230\" y2=\"140\" stroke=\"#a78bfa\" stroke-width=\"2\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"170\" y1=\"185\" x2=\"230\" y2=\"195\" stroke=\"#a78bfa\" stroke-width=\"2\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"170\" y1=\"185\" x2=\"230\" y2=\"250\" stroke=\"#a78bfa\" stroke-width=\"2\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"360\" y1=\"140\" x2=\"420\" y2=\"115\" stroke=\"#a78bfa\" stroke-width=\"1.5\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"360\" y1=\"150\" x2=\"420\" y2=\"175\" stroke=\"#a78bfa\" stroke-width=\"1.5\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"360\" y1=\"240\" x2=\"420\" y2=\"280\" stroke=\"#a78bfa\" stroke-width=\"1.5\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"550\" y1=\"280\" x2=\"610\" y2=\"280\" stroke=\"#a78bfa\" stroke-width=\"2\" marker-end=\"url(#arrowE1)\"/>\n        <line x1=\"485\" y1=\"190\" x2=\"485\" y2=\"205\" stroke=\"#a78bfa\" stroke-width=\"1.5\" stroke-dasharray=\"3\" marker-end=\"url(#arrowE1)\"/>\n        <defs><marker id=\"arrowE1\" markerWidth=\"8\" markerHeight=\"6\" refX=\"8\" refY=\"3\" orient=\"auto\"><path d=\"M0,0 L8,3 L0,6\" fill=\"#a78bfa\"/></marker></defs>\n      </svg>\n      </div>\n      <p>The diagram above is the answer this whole design converges on: client traffic hits the CDN and gateway first (edge, auth, rate limiting), fans out to independently-scalable services behind it, each service reads through Redis before Postgres and writes to Postgres's primary with replicas absorbing read load, anything non-blocking goes through a queue to async workers, and every single layer \u2014 client through worker \u2014 reports into one observability stack rather than each having its own island of logs no one correlates.</p>\n      <p><strong>Good interview signal:</strong> notice what's <em>not</em> in the diagram at this scale \u2014 no sharded database, no service mesh, no multi-region active-active setup. Naming what you deliberately left out, and why, is as strong a signal as naming what you included.</p>`\n    },\n    {\n      q:\"What would you build for an MVP vs. design in from day one?\",\n      a:`<p>Some things are genuinely fine to defer because retrofitting them later is a bounded, well-understood amount of work: read replicas, sharding, a service mesh, and multi-region can all be added once real traffic proves they're needed, without a rewrite. Other things are expensive or impossible to retrofit cleanly, and belong in the design from day one even for an MVP: the service boundaries and API contracts (a bad boundary calcifies fast once other things depend on it), auth and the security posture around sensitive data (retrofitting security is where breaches come from), and basic observability (you cannot debug production problems on a system you were never watching \u2014 this one is cheap to add early and very expensive to be missing during an incident).</p>`\n    },\n    {\n      q:\"How do you pace this as a 30\u201345 minute interview answer?\",\n      a:`<p>Roughly: 5 minutes clarifying requirements and stating the capacity estimate, 10\u201315 minutes on the high-level architecture \u2014 walk left to right through client &rarr; edge &rarr; services &rarr; data, at a level where every box gets one sentence, not a paragraph \u2014 then let the interviewer steer the remaining 15\u201320 minutes into 2\u20133 components they want depth on (this is usually caching, the database, or reliability), and close with 5 minutes on trade-offs: what you'd cut for an MVP, and the one or two things you're least confident about and would want to validate with load testing before shipping. Ending on that last, honest note \u2014 naming your own uncertainty \u2014 reads as seniority, not weakness.</p>`\n    }\n  ]\n}\n];\n// ---------- render ----------\nconst navList = document.getElementById('navList');\nconst content = document.getElementById('content');\nlet activeId = DATA[0].id;\nconst STORAGE_KEY = 'system-design-scale-reviewed-v1';\n\nfunction loadReviewed(){\n  try{\n    const raw = localStorage.getItem(STORAGE_KEY);\n    return raw ? JSON.parse(raw) : {};\n  }catch(e){ return {}; }\n}\nfunction saveReviewed(obj){\n  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(obj)); }catch(e){}\n}\nlet reviewed = loadReviewed();\n\nfunction totalQuestions(){\n  return DATA.reduce((n,s)=>n+s.questions.length,0);\n}\nfunction reviewedCount(){\n  return Object.values(reviewed).filter(Boolean).length;\n}\nfunction updateProgress(){\n  const total = totalQuestions();\n  const done = reviewedCount();\n  document.getElementById('progressNum').textContent = done + ' / ' + total;\n  document.getElementById('progressFill').style.width = (total? (done/total*100):0) + '%';\n}\n\nfunction renderNav(){\n  navList.innerHTML = '';\n  DATA.forEach((section, idx)=>{\n    const btn = document.createElement('button');\n    btn.className = 'nav-item' + (section.id===activeId ? ' active':'');\n    btn.innerHTML = `<span class=\"nav-num\">${String(idx+1).padStart(2,'0')}</span><span class=\"nav-label\">${section.title}</span><span class=\"nav-count\">${section.questions.length}</span>`;\n    btn.addEventListener('click', ()=>{ activeId = section.id; renderNav(); renderContent(); });\n    navList.appendChild(btn);\n  });\n}\n\nfunction qKey(sectionId, qIdx){ return sectionId + ':' + qIdx; }\n\nfunction renderContent(pendingQIdx){\n  content.innerHTML = '';\n  const section = DATA.find(s=>s.id===activeId);\n  const idx = DATA.findIndex(s=>s.id===activeId);\n  const head = document.createElement('div');\n  head.className = 'section-head';\n  head.innerHTML = `<span class=\"num\">${String(idx+1).padStart(2,'0')}</span><h2>${section.title}</h2><span class=\"count\">${section.questions.length} question${section.questions.length>1?'s':''}</span>`;\n  content.appendChild(head);\n\n  section.questions.forEach((item, qIdx)=>{\n    const key = qKey(section.id, qIdx);\n    const isDone = !!reviewed[key];\n    const card = document.createElement('div');\n    card.className = 'qcard';\n\n    const qhead = document.createElement('div');\n    qhead.className = 'qhead';\n    qhead.innerHTML = `\n      <span class=\"qcheck ${isDone?'done':''}\"></span>\n      <span class=\"qtext ${isDone?'done-text':''}\">${item.q}</span>\n      <span class=\"qchevron\">\u203a</span>\n    `;\n    const checkEl = qhead.querySelector('.qcheck');\n    const textEl = qhead.querySelector('.qtext');\n    checkEl.addEventListener('click', (e)=>{\n      e.stopPropagation();\n      reviewed[key] = !reviewed[key];\n      saveReviewed(reviewed);\n      checkEl.classList.toggle('done');\n      textEl.classList.toggle('done-text');\n      updateProgress();\n    });\n    qhead.addEventListener('click', ()=>{ card.classList.toggle('open'); });\n\n    const body = document.createElement('div');\n    body.className = 'qbody';\n    body.innerHTML = item.a;\n\n    card.appendChild(qhead);\n    card.appendChild(body);\n    content.appendChild(card);\n  });\n\n  if(typeof pendingQIdx === 'number'){\n    const target = content.children[pendingQIdx + 1];\n    if(target){\n      target.classList.add('open');\n      target.scrollIntoView({ behavior:'smooth', block:'start' });\n    }\n  }\n}\n\ndocument.getElementById('resetBtn').addEventListener('click', ()=>{\n  reviewed = {};\n  saveReviewed(reviewed);\n  renderContent();\n  updateProgress();\n});\n\nwindow.addEventListener('message', (e)=>{\n  if(e.data && e.data.type==='goto-section' && DATA.find(s=>s.id===e.data.id)){\n    activeId = e.data.id;\n    renderNav();\n    renderContent(typeof e.data.qIdx === 'number' && !Number.isNaN(e.data.qIdx) ? e.data.qIdx : undefined);\n  }\n});\n\nrenderNav();\nrenderContent();\nupdateProgress();\n</script>\n</body>\n</html>\n"}